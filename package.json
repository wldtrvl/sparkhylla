{
  "name": "sprakhylla",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx --env-file=.env.local scripts/eval-models.ts",
    "import:gutenberg": "tsx --env-file=.env.local scripts/import-gutenberg.ts",
    "import:text": "tsx --env-file=.env.local scripts/import-text.ts",
    "vocab:build": "tsx --env-file=.env.local scripts/build-vocab.ts",
    "db:types": "bash scripts/gen-db-types.sh",
    "e2e": "playwright test",
    "import:batch": "tsx --conditions=react-server --env-file=.env.local scripts/import-batch.ts",
    "import:voa": "tsx --env-file=.env.local scripts/import-voa.ts",
    "import:wiki": "tsx --conditions=react-server --env-file=.env.local scripts/import-wiki.ts",
    "import:bokselskap": "tsx --conditions=react-server --env-file=.env.local scripts/import-bokselskap.ts",
    "updates:add": "tsx --conditions=react-server --env-file=.env.local scripts/add-update.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "fflate": "^0.8.3",
    "next": "16.3.8",
    "node-html-parser": "^9.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
