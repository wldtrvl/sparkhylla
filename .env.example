# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI providers: add any you have; tasks fall back across available ones ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: override which model handles which task (database table model_routes wins over this).
# AI_ROUTES={"gloss":[{"provider":"google","model":"gemini-3.1-flash-lite","weight":1}]}
# Optional: price corrections, USD per million tokens
# AI_PRICE_OVERRIDES={"google:gemini-3.8-flash":{"in":1.5,"out":7.5}}
# Store full prompts and replies in llm_calls for analysis (contains the learner's text)
LOG_AI_PAYLOADS=true

# ---- Speech ----
# Speech-to-text order: openai (gpt-4o-mini-transcribe) and/or google (Gemini audio)
STT_PROVIDERS=openai,google
# Gemini model for speech-to-text (default gemini-3.8-flash; gemini-3.1-flash-lite is cheaper)
GEMINI_STT_MODEL=gemini-3.8-flash
# Text-to-speech order: google (Cloud Text-to-Speech, natural nb-NO voices) and/or openai
TTS_PROVIDERS=google,openai
GOOGLE_TTS_API_KEY=
# Optional exact voice names (Cloud TTS voice list); empty = default female voice for the language
TTS_VOICE_NO=
TTS_VOICE_EN=

NEXT_PUBLIC_APP_VERSION=0.1.0
